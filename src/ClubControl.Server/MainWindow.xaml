<Window x:Class="ClubControl.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClubControl" Height="700" Width="1150">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" Text="Starting..." />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Margin="0,0,6,0" Click="OnStart" />
                    <Button x:Name="ExtendButton" Margin="0,0,6,0" Click="OnExtend" />
                    <Button x:Name="StopButton" Margin="0,0,6,0" Click="OnStop" />
                    <Button x:Name="MoveButton" Margin="0,0,14,0" Click="OnMove" />
                    <Border Width="1" Background="{StaticResource DividerBrush}" Margin="0,2,14,2" />
                    <Button x:Name="TurnOnButton" Margin="0,0,6,0" Click="OnTurnOn" />
                    <Button x:Name="RestartButton" Margin="0,0,6,0" Click="OnRestart" />
                    <Button x:Name="ShutDownButton" Margin="0,0,14,0" Click="OnShutDown" />
                    <Border Width="1" Background="{StaticResource DividerBrush}" Margin="0,2,14,2" />
                    <Button x:Name="AddComputerButton" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnAddComputer" />
                    <Button x:Name="AddBilliardButton" Margin="0,0,14,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnAddBilliard" />
                    <Border Width="1" Background="{StaticResource DividerBrush}" Margin="0,2,14,2" />
                    <Button x:Name="SettingsButton" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnSettings" />
                    <Button x:Name="ReportsButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnReports" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Padding="12,10" Height="160">
            <DockPanel>
                <TextBlock x:Name="EventLogHeaderText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="EventLogList" BorderThickness="0" FontFamily="Consolas" Background="Transparent" />
            </DockPanel>
        </Border>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="PcGrid" Margin="1" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                      SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"
                      PreviewMouseRightButtonDown="PcGrid_PreviewMouseRightButtonDown">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Background" Value="{Binding RowBrush}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CtxStart" Click="OnStart" />
                        <MenuItem x:Name="CtxFree" Click="OnFree" />
                        <MenuItem x:Name="CtxExtend" Click="OnExtend" />
                        <MenuItem x:Name="CtxStop" Click="OnStop" />
                        <MenuItem x:Name="CtxMove" Click="OnMove" />
                        <Separator />
                        <MenuItem x:Name="CtxTurnOn" Click="OnTurnOn" />
                        <MenuItem x:Name="CtxRestart" Click="OnRestart" />
                        <MenuItem x:Name="CtxShutDown" Click="OnShutDown" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="●" Width="26">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="KindIconColumn" Binding="{Binding KindIcon}" Width="34" />
                    <DataGridTextColumn x:Name="PcNumberColumn" Binding="{Binding Number}" Width="50" />
                    <DataGridTextColumn x:Name="TariffColumn" Binding="{Binding TariffDisplay}" Width="100" />
                    <DataGridTextColumn x:Name="StateColumn" Binding="{Binding StateDisplay}" Width="110" />
                    <DataGridTextColumn x:Name="SessionColumn" Binding="{Binding SessionTypeDisplay}" Width="80" />
                    <DataGridTextColumn x:Name="AmountColumn" Binding="{Binding AmountDisplay}" Width="110" />
                    <DataGridTextColumn x:Name="StartColumn" Binding="{Binding StartDisplay}" Width="80" />
                    <DataGridTextColumn x:Name="EndColumn" Binding="{Binding EndDisplay}" Width="80" />
                    <DataGridTextColumn x:Name="RemainingColumn" Binding="{Binding RemainingDisplay}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
