<Window x:Class="ClubControl.Server.Windows.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="NameLabel" Margin="0,0,0,2" />
        <TextBox x:Name="NameBox" MaxLength="100" Margin="0,0,0,10" />

        <TextBlock x:Name="PriceLabel" Margin="0,0,0,2" />
        <TextBox x:Name="PriceBox" Margin="0,0,0,10" />

        <!-- Only when adding: afterwards stock changes go through "Adjust stock" so each one is logged -->
        <StackPanel x:Name="StockPanel">
            <TextBlock x:Name="StockLabel" Margin="0,0,0,2" />
            <TextBox x:Name="StockBox" Margin="0,0,0,10" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Width="110" Height="38" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Click="OnCancel" />
            <Button x:Name="SaveButton" Width="110" Height="38" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
