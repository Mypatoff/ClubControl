<Window x:Class="ClubControl.Server.Windows.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add item" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="TargetText" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap" />

        <!-- Items already added to this session, each removable in case of a mistake -->
        <StackPanel x:Name="AddedPanel" Margin="0,0,0,12">
            <TextBlock x:Name="AddedLabel" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="✕" Width="28" Height="26" Padding="0"
                                        Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding Id}" Click="OnRemove" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="AddedTotalText" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl x:Name="SourceTabs" Margin="0,0,0,10">
            <!-- A bar product: it is also a bar sale (stock goes down), on the session's bill unless it is unpaid -->
            <TabItem x:Name="BarTab">
                <StackPanel Margin="4,10,4,4">
                    <TextBlock x:Name="ProductLabel" Margin="0,0,0,2" />
                    <ComboBox x:Name="ProductBox" DisplayMemberPath="Display" Margin="0,0,0,10" SelectionChanged="OnBarInputChanged" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock x:Name="QuantityLabel" Margin="0,0,0,2" />
                            <TextBox x:Name="QuantityBox" Text="1" TextChanged="OnBarTextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock x:Name="CupsLabel" Margin="0,0,0,2" />
                            <TextBox x:Name="CupsBox" Text="0" TextChanged="OnBarTextChanged" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="UnpaidCheck" Margin="0,0,0,6" Checked="OnUnpaidToggled" Unchecked="OnUnpaidToggled" />
                    <StackPanel x:Name="CommentPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock x:Name="CommentLabel" Margin="0,0,0,2" />
                        <TextBox x:Name="CommentBox" MaxLength="200" />
                    </StackPanel>

                    <TextBlock x:Name="BarTotalText" FontWeight="Bold" HorizontalAlignment="Right" />
                </StackPanel>
            </TabItem>

            <!-- Anything that is not in the bar: just a name and a price, as before -->
            <TabItem x:Name="OtherTab">
                <StackPanel Margin="4,10,4,4">
                    <TextBlock x:Name="NameLabel" Margin="0,0,0,2" />
                    <TextBox x:Name="NameBox" MaxLength="60" Margin="0,0,0,10" />

                    <TextBlock x:Name="AmountLabel" Margin="0,0,0,2" />
                    <TextBox x:Name="AmountBox" Margin="0,0,0,4" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ResultText" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CloseButton" Width="110" Height="38" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnClose" IsCancel="True" />
            <Button x:Name="AddButton" Width="110" Height="38" IsDefault="True" Click="OnAdd" />
        </StackPanel>
    </StackPanel>
</Window>
