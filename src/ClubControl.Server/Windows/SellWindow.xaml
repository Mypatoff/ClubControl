<Window x:Class="ClubControl.Server.Windows.SellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sell" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap" />

        <TextBlock x:Name="ProductLabel" Margin="0,0,0,2" />
        <ComboBox x:Name="ProductBox" DisplayMemberPath="Display" Margin="0,0,0,10" SelectionChanged="OnInputChanged" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock x:Name="QuantityLabel" Margin="0,0,0,2" />
                <TextBox x:Name="QuantityBox" Text="1" TextChanged="OnTextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock x:Name="CupsLabel" Margin="0,0,0,2" />
                <TextBox x:Name="CupsBox" Text="0" TextChanged="OnTextChanged" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="UnpaidCheck" Margin="0,0,0,6" Checked="OnUnpaidToggled" Unchecked="OnUnpaidToggled" />
        <StackPanel x:Name="CommentPanel" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock x:Name="CommentLabel" Margin="0,0,0,2" />
            <TextBox x:Name="CommentBox" MaxLength="200" />
        </StackPanel>

        <TextBlock x:Name="TotalText" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,0,8" />

        <TextBlock x:Name="ResultText" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CloseButton" Width="110" Height="38" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnClose" IsCancel="True" />
            <Button x:Name="SellButton" Width="110" Height="38" IsDefault="True" Click="OnSell" />
        </StackPanel>
    </StackPanel>
</Window>
