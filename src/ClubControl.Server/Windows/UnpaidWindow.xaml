<Window x:Class="ClubControl.Server.Windows.UnpaidWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unpaid" Width="820" Height="460" MinWidth="620" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <TextBlock x:Name="TotalText" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="VoidButton" Height="38" Margin="0,0,10,0" Padding="16,0" Style="{StaticResource DangerButtonStyle}" Click="OnVoid" />
            <Button x:Name="PaidButton" Height="38" Margin="0,0,10,0" Padding="16,0" Style="{StaticResource SuccessButtonStyle}" Click="OnMarkPaid" />
            <Button x:Name="CloseButton" Width="110" Height="38" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Click="OnClose" />
        </StackPanel>

        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />

        <DataGrid x:Name="UnpaidGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="TimeColumn" Binding="{Binding TimeDisplay}" Width="100" />
                <DataGridTextColumn x:Name="ProductColumn" Binding="{Binding Product}" Width="*" />
                <DataGridTextColumn x:Name="AmountColumn" Binding="{Binding AmountDisplay}" Width="110" />
                <DataGridTextColumn x:Name="WhereColumn" Binding="{Binding Where}" Width="90" />
                <DataGridTextColumn x:Name="CommentColumn" Binding="{Binding Comment}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
