<Window x:Class="ClubControl.Server.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="680" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Width="90" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancel" IsCancel="True" />
            <Button x:Name="SaveButton" Width="90" IsDefault="True" Click="OnSave" />
        </StackPanel>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8">
        <TabControl Margin="4">
            <TabItem x:Name="GeneralTab">
                <StackPanel Margin="12">
                    <TextBlock x:Name="ClubNameLabel" Margin="0,0,0,2" />
                    <TextBox x:Name="ClubNameBox" Margin="0,0,0,10" />

                    <TextBlock x:Name="LockScreenTextLabel" Margin="0,0,0,2" />
                    <TextBox x:Name="LockScreenTextBox" Margin="0,0,0,10" />

                    <TextBlock x:Name="LockScreenLanguageLabel" Margin="0,0,0,2" />
                    <ComboBox x:Name="LockScreenLanguageCombo" DisplayMemberPath="Display" Margin="0,0,0,10" />

                    <TextBlock x:Name="AdminPanelLanguageLabel" Margin="0,0,0,2" />
                    <ComboBox x:Name="AdminPanelLanguageCombo" DisplayMemberPath="Display" Margin="0,0,0,10" />

                    <TextBlock x:Name="UiThemeLabel" Margin="0,0,0,2" />
                    <ComboBox x:Name="UiThemeCombo" DisplayMemberPath="Display" Margin="0,0,0,10" />

                    <TextBlock x:Name="WarningMinutesLabel" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="WarningMinutes1Box" Width="60" />
                        <TextBox x:Name="WarningMinutes2Box" Width="60" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="AfterSessionActionLabel" Margin="0,0,0,2" />
                    <ComboBox x:Name="AfterSessionActionCombo" DisplayMemberPath="Display" Margin="0,0,0,10" />

                    <TextBlock x:Name="ProcessListLabel" Margin="0,0,0,2" />
                    <TextBox x:Name="ProcessListBox" Margin="0,0,0,10" />

                    <TextBlock x:Name="OfflineWaitLabel" Margin="0,0,0,2" />
                    <TextBox x:Name="OfflineWaitBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <TextBlock x:Name="AutoShutdownLabel" Margin="0,0,0,2" />
                    <TextBox x:Name="AutoShutdownBox" Width="80" HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>

            <TabItem x:Name="TariffsTab">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AddTariffButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnAddTariff" />
                        <Button x:Name="DeleteTariffButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnDeleteTariff" />
                    </StackPanel>
                    <DataGrid x:Name="TariffGrid" AutoGenerateColumns="False" CanUserAddRows="False" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="TariffNameColumn" Binding="{Binding Name}" Width="140" />
                            <DataGridComboBoxColumn x:Name="TariffKindColumn" SelectedValueBinding="{Binding Kind}"
                                                     DisplayMemberPath="Display" SelectedValuePath="Value" Width="110" />
                            <DataGridTextColumn x:Name="TariffPriceColumn" Binding="{Binding PricePerHourUzs}" Width="110" />
                            <DataGridTextColumn x:Name="TariffMinColumn" Binding="{Binding MinPaymentUzs}" Width="110" />
                            <DataGridTextColumn x:Name="TariffMaxColumn" Binding="{Binding MaxPaymentUzs}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="ComputersTab">
                <DockPanel Margin="12">
                    <TextBlock x:Name="ComputersHintText" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AddComputerButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnAddComputer" />
                        <Button x:Name="AddBilliardButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnAddBilliard" />
                        <Button x:Name="DeleteResourceButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnDeleteResource" />
                    </StackPanel>
                    <DataGrid x:Name="PcGrid" AutoGenerateColumns="False" CanUserAddRows="False" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="KindColumn" Binding="{Binding Kind}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn x:Name="PcNumberColumn" Binding="{Binding Number}" Width="60" />
                            <DataGridComboBoxColumn x:Name="TariffColumn" SelectedValueBinding="{Binding TariffId}"
                                                     DisplayMemberPath="Name" SelectedValuePath="Id" Width="120" />
                            <DataGridCheckBoxColumn x:Name="EnabledColumn" Binding="{Binding Enabled}" Width="60" />
                            <DataGridTextColumn x:Name="HostnameColumn" Binding="{Binding Hostname}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn x:Name="IpColumn" Binding="{Binding IpAddress}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn x:Name="MacColumn" Binding="{Binding MacAddress}" Width="120" IsReadOnly="True" />
                            <DataGridCheckBoxColumn x:Name="OnlineColumn" Binding="{Binding IsOnline}" Width="55" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        </Border>
    </DockPanel>
</Window>
