<Window x:Class="ClubControl.Server.Windows.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reports" Width="820" Height="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="DailyButton" Padding="10,4" Margin="0,0,6,0" Click="OnDaily" />
            <Button x:Name="WeeklyButton" Padding="10,4" Margin="0,0,6,0" Click="OnWeekly" />
            <Button x:Name="MonthlyButton" Padding="10,4" Margin="0,0,16,0" Click="OnMonthly" />

            <TextBlock x:Name="FromLabelText" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker x:Name="FromDatePicker" Width="120" Margin="0,0,16,0" />
            <TextBlock x:Name="ToLabelText" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker x:Name="ToDatePicker" Width="120" Margin="0,0,16,0" />

            <Button x:Name="RefreshButton" Padding="10,4" Click="OnRefresh" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Width="90" Click="OnClose" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TotalIncomeLabel" FontWeight="Bold" />
                <TextBlock x:Name="TotalIncomeValue" FontSize="18" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TotalSessionsLabel" FontWeight="Bold" />
                <TextBlock x:Name="TotalSessionsValue" FontSize="18" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="TotalHoursLabel" FontWeight="Bold" />
                <TextBlock x:Name="TotalHoursValue" FontSize="18" />
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock x:Name="FreeMinutesLabel" FontWeight="Bold" />
                <TextBlock x:Name="FreeMinutesValue" FontSize="18" />
            </StackPanel>
        </Grid>

        <TabControl>
            <TabItem x:Name="ByPcTab">
                <DataGrid x:Name="ByPcGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ByPcNumberColumn" Binding="{Binding PcLabel}" Width="120" />
                        <DataGridTextColumn x:Name="ByPcIncomeColumn" Binding="{Binding IncomeDisplay}" Width="140" />
                        <DataGridTextColumn x:Name="ByPcSessionsColumn" Binding="{Binding SessionCount}" Width="100" />
                        <DataGridTextColumn x:Name="ByPcHoursColumn" Binding="{Binding HoursDisplay}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="ByClassTab">
                <DataGrid x:Name="ByClassGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ByClassNameColumn" Binding="{Binding ClassLabel}" Width="120" />
                        <DataGridTextColumn x:Name="ByClassIncomeColumn" Binding="{Binding IncomeDisplay}" Width="140" />
                        <DataGridTextColumn x:Name="ByClassSessionsColumn" Binding="{Binding SessionCount}" Width="100" />
                        <DataGridTextColumn x:Name="ByClassHoursColumn" Binding="{Binding HoursDisplay}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="ByTypeTab">
                <DataGrid x:Name="ByTypeGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ByTypeNameColumn" Binding="{Binding TypeLabel}" Width="120" />
                        <DataGridTextColumn x:Name="ByTypeIncomeColumn" Binding="{Binding IncomeDisplay}" Width="140" />
                        <DataGridTextColumn x:Name="ByTypeSessionsColumn" Binding="{Binding SessionCount}" Width="100" />
                        <DataGridTextColumn x:Name="ByTypeHoursColumn" Binding="{Binding HoursDisplay}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
