<Window x:Class="ClubControl.Server.Windows.ServerUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update server" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap" />

        <TextBlock x:Name="InstalledText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="LatestText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />

        <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
        <ProgressBar x:Name="DownloadBar" Height="8" Minimum="0" Maximum="1" Margin="0,8,0,0" Visibility="Collapsed" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock x:Name="NoteText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OpenPageButton" Height="38" Padding="14,0" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenPage" />
            <Button x:Name="CloseButton" Width="110" Height="38" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnClose" IsCancel="True" />
            <Button x:Name="UpdateButton" Height="38" Padding="14,0" Style="{StaticResource SuccessButtonStyle}" IsEnabled="False" Click="OnUpdate" />
        </StackPanel>
    </StackPanel>
</Window>
