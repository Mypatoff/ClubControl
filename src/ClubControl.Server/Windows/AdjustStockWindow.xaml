<Window x:Class="ClubControl.Server.Windows.AdjustStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust stock" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" TextWrapping="Wrap" />

        <TextBlock x:Name="DeltaLabel" Margin="0,0,0,2" TextWrapping="Wrap" />
        <TextBox x:Name="DeltaBox" Margin="0,0,0,10" />

        <TextBlock x:Name="ReasonLabel" Margin="0,0,0,2" />
        <ComboBox x:Name="ReasonBox" DisplayMemberPath="Label" Margin="0,0,0,10" />

        <TextBlock x:Name="NoteLabel" Margin="0,0,0,2" />
        <TextBox x:Name="NoteBox" MaxLength="200" Margin="0,0,0,10" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Width="110" Height="38" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Click="OnCancel" />
            <Button x:Name="SaveButton" Width="110" Height="38" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
