<Window x:Class="ClubControl.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClubControl Client (Phase 1 skeleton)" Height="160" Width="420"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" FontSize="16" Text="Searching for server..." TextWrapping="Wrap" />
        <TextBlock x:Name="DetailText" FontSize="12" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
