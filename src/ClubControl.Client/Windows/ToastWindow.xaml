<Window x:Class="ClubControl.Client.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent"
        Width="360" Height="64" WindowStartupLocation="Manual">
    <Border Background="#E6141414" BorderBrush="#4D2F6FED" BorderThickness="1" CornerRadius="10">
        <TextBlock x:Name="MessageText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                   FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="16,8" />
    </Border>
</Window>
