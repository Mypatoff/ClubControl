<Window x:Class="ClubControl.Client.Windows.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual" Background="Black">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
            <TextBlock x:Name="ClubNameText" Foreground="White" FontSize="40" FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="PcInfoText" Foreground="White" FontSize="22" Margin="0,16,0,0"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="MessageText" Foreground="Orange" FontSize="28" Margin="0,28,0,0"
                       HorizontalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="CustomText" Foreground="Gray" FontSize="16" Margin="0,28,0,0"
                       HorizontalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
