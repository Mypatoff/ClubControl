<Window x:Class="ClubControl.Client.Windows.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0B12" Offset="0" />
            <GradientStop Color="#171030" Offset="0.5" />
            <GradientStop Color="#0A0B12" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <!-- Decorative glow and light streaks - an abstract "gaming lounge" look, not tied to any one game's artwork. -->
        <Ellipse Width="1000" Height="1000" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2F6FED" Offset="0" />
                    <GradientStop Color="#2F6FED" Offset="0.15" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="700" Height="700" Opacity="0.22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-250">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#A23FE0" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Rectangle Width="3" Height="2000" Opacity="0.5" HorizontalAlignment="Left" Margin="220,0,0,0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="#2F6FED" Offset="0.5" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <RotateTransform Angle="18" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="2" Height="2000" Opacity="0.4" HorizontalAlignment="Right" Margin="0,0,260,0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0" />
                    <GradientStop Color="#A23FE0" Offset="0.5" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <RotateTransform Angle="-16" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- Content card -->
        <Border Background="#33141A2E" BorderBrush="#402F6FED" BorderThickness="1" CornerRadius="18"
                Padding="56,44" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
            <StackPanel>
                <TextBlock x:Name="ClubNameText" Foreground="White" FontSize="44" FontWeight="Bold"
                           FontFamily="Segoe UI" HorizontalAlignment="Center" />
                <Border Width="56" Height="4" Background="#2F6FED" CornerRadius="2" Margin="0,18,0,0"
                        HorizontalAlignment="Center" />
                <TextBlock x:Name="PcInfoText" Foreground="#9FB4E8" FontSize="22" Margin="0,22,0,0"
                           FontFamily="Segoe UI" HorizontalAlignment="Center" />
                <TextBlock x:Name="MessageText" Foreground="#F5A623" FontSize="28" FontWeight="SemiBold"
                           FontFamily="Segoe UI" Margin="0,28,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="CustomText" Foreground="#8A8F99" FontSize="16"
                           FontFamily="Segoe UI" Margin="0,28,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
