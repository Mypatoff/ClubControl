<Window x:Class="ClubControl.Client.Windows.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual" Background="#0B0D12">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
            <TextBlock x:Name="ClubNameText" Foreground="White" FontSize="44" FontWeight="Bold"
                       FontFamily="Segoe UI" HorizontalAlignment="Center" />
            <Border Width="56" Height="4" Background="#2F6FED" CornerRadius="2" Margin="0,18,0,0"
                    HorizontalAlignment="Center" />
            <TextBlock x:Name="PcInfoText" Foreground="#9FB4E8" FontSize="22" Margin="0,22,0,0"
                       FontFamily="Segoe UI" HorizontalAlignment="Center" />
            <TextBlock x:Name="MessageText" Foreground="#F5A623" FontSize="28" FontWeight="SemiBold"
                       FontFamily="Segoe UI" Margin="0,28,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="CustomText" Foreground="#8A8F99" FontSize="16"
                       FontFamily="Segoe UI" Margin="0,28,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
