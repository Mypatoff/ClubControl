<Window x:Class="ClubControl.Client.Windows.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent" Opacity="0.55"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
    <!-- Small, faint and click-through (see OnSourceInitialized): it must never get in the way of a game. -->
    <Border Background="#99000000" CornerRadius="6" Padding="8,2">
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="MainText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI" VerticalAlignment="Center" />
                <TextBlock x:Name="SubText" Foreground="#AEB4BD" FontSize="10"
                           FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="BadgeText" Foreground="#F5A623" FontSize="10"
                       FontFamily="Segoe UI" HorizontalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
