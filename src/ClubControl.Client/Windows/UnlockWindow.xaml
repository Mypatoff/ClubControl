<Window x:Class="ClubControl.Client.Windows.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="CenterScreen"
        Width="400" SizeToContent="Height" Background="Transparent" AllowsTransparency="True">
    <Border Background="#F2141A2E" BorderBrush="#802F6FED" BorderThickness="1" CornerRadius="14" Padding="28,24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI" />
            <TextBlock x:Name="PromptText" Foreground="#9FB4E8" FontSize="13" FontFamily="Segoe UI" Margin="0,6,0,14" TextWrapping="Wrap" />

            <PasswordBox x:Name="PasswordBox" FontSize="16" Padding="8,6" />

            <TextBlock x:Name="ErrorText" Foreground="#F5A623" FontSize="13" FontFamily="Segoe UI" Margin="0,10,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Width="100" Height="34" Margin="0,0,10,0" IsCancel="True" Click="OnCancel" />
                <Button x:Name="OkButton" Width="100" Height="34" IsDefault="True" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
