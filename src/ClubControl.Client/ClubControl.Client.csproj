<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ClubControl.Client</RootNamespace>
    <ApplicationIcon>..\..\assets\ClubControl.ico</ApplicationIcon>
    <Product>ClubControl</Product>
    <SatelliteResourceLanguages>en;ru;uz</SatelliteResourceLanguages>
    <AssemblyTitle>ClubControl Client</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClubControl.Shared\ClubControl.Shared.csproj" />
  </ItemGroup>

</Project>
